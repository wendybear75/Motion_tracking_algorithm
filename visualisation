import os
import re
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ── Configuration ─────────────────────────────────────────────────────────────
SUMMARY_CSV   = r"C:/Users/E123502/OneDrive - RMIT University/REVENTA data/3D estimation/displacement_results/displacement_all_patients.csv"
OUTPUT_FOLDER = r"C:/Users/E123502/OneDrive - RMIT University/REVENTA data/3D estimation/displacement_results/lead_plots/test/"

os.makedirs(OUTPUT_FOLDER, exist_ok=True)

DIRECTIONS = ['LR', 'SI', 'AP']
COLORS     = {'LR': '#4C72B0', 'SI': '#DD8452', 'AP': '#55A868'}

# ── Load data ─────────────────────────────────────────────────────────────────
df = pd.read_csv(SUMMARY_CSV)

# lead_base: RV, LV, RA  (used to group figures)
# lead_full: RV_1, RV_2  (used as the row label — kept as-is from the CSV)
df['lead_base'] = df['lead'].str.replace(r'_\d+$', '', regex=True)

lead_bases = sorted(df['lead_base'].unique())
print(f"Lead types found: {lead_bases}\n")

# ── One figure per lead base type ─────────────────────────────────────────────
for lead in lead_bases:
    df_lead = df[df['lead_base'] == lead]

    # Each row = unique (patient, lead_full) pair — so RV_1 and RV_2 are separate rows
    groups = (
        df_lead[['patient', 'lead']]
        .drop_duplicates()
        .sort_values(['patient', 'lead'])
        .values.tolist()          # -> [['SYD001', 'RV_1'], ['SYD001', 'RV_2'], ...]
    )
    n_rows = len(groups)

    fig, axes = plt.subplots(
        nrows=n_rows, ncols=3,
        figsize=(12, 2.5 * n_rows),
        sharex='col', sharey=False,
        squeeze=False,
    )

    fig.suptitle(f'Lead motion — {lead}', fontsize=15, fontweight='bold', y=1.01)

    # ── PASS 1: compute shared limits from all data in this lead group ─────────
    x_max = {}
    y_max = {}
    for direction in DIRECTIONS:
        vals = df_lead[df_lead['direction'] == direction]['values'].dropna().values
        x_max[direction] = np.percentile(vals, 99) if len(vals) > 0 else 1
        y_max[direction] = 0

    for patient, lead_full in groups:
        df_row = df_lead[(df_lead['patient'] == patient) & (df_lead['lead'] == lead_full)]
        for direction in DIRECTIONS:
            values = df_row[df_row['direction'] == direction]['values'].dropna().values
            if len(values) == 0:
                continue
            counts, _ = np.histogram(values, bins=30, range=(0, x_max[direction]))
            if counts.max() > y_max[direction]:
                y_max[direction] = counts.max()

    # ── PASS 2: draw histograms then apply finalised limits ────────────────────
    for row, (patient, lead_full) in enumerate(groups):
        df_row = df_lead[(df_lead['patient'] == patient) & (df_lead['lead'] == lead_full)]
        row_label = f"{patient}\n{lead_full}"

        for col, direction in enumerate(DIRECTIONS):
            ax = axes[row, col]
            values = df_row[df_row['direction'] == direction]['values'].dropna().values

            if len(values) == 0:
                ax.text(0.5, 0.5, 'no data', ha='center', va='center',
                        transform=ax.transAxes, fontsize=9, color='grey')
            else:
                ax.hist(values, bins=30, color=COLORS[direction],
                        alpha=0.75, edgecolor='none',
                        range=(0, x_max[direction]))
                median = np.median(values)
                ax.axvline(median, color='black', linewidth=1.2, linestyle='--',
                           label=f'median={median:.1f}')
                ax.legend(fontsize=8, frameon=False)

            ax.set_xlim(0, x_max[direction])
            ax.set_ylim(0, y_max[direction] * 1.15)
            ax.spines['top'].set_visible(False)
            ax.spines['right'].set_visible(False)

            if row == 0:
                ax.set_title(direction, fontsize=12, color=COLORS[direction], fontweight='bold')
            if col == 0:
                ax.set_ylabel(row_label, fontsize=9, rotation=0, labelpad=60, va='center')
            if row == n_rows - 1:
                ax.set_xlabel('Displacement (mm)', fontsize=10)

    plt.tight_layout()
    out_path = os.path.join(OUTPUT_FOLDER, f"lead_motion_{lead}.png")
    plt.savefig(out_path, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"Saved: {out_path}")

# ── Summary boxplot: grouped by lead base type (RV, LV, RA) ──────────────────
fig, axes = plt.subplots(1, 3, figsize=(14, 5), sharey=True)
fig.suptitle('Displacement summary — all leads', fontsize=14, fontweight='bold')

for col, direction in enumerate(DIRECTIONS):
    ax = axes[col]
    df_dir = df[df['direction'] == direction]

    # group by lead_base so RV_1 and RV_2 are pooled together under RV
    data_by_lead = [df_dir[df_dir['lead_base'] == l]['values'].dropna().values for l in lead_bases]

    bp = ax.boxplot(
        data_by_lead,
        labels=lead_bases,
        patch_artist=True,
        medianprops=dict(color='black', linewidth=1.5),
        whiskerprops=dict(linewidth=1),
        capprops=dict(linewidth=1),
        flierprops=dict(marker='o', markersize=3, alpha=0.4),
    )

    for patch in bp['boxes']:
        patch.set_facecolor(COLORS[direction])
        patch.set_alpha(0.7)

    ax.set_title(direction, fontsize=12, color=COLORS[direction], fontweight='bold')
    ax.set_xlabel('Lead', fontsize=11)
    ax.set_ylabel('Displacement (mm)', fontsize=11)
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    ax.tick_params(axis='x', labelsize=9)

plt.tight_layout()
summary_path = os.path.join(OUTPUT_FOLDER, "lead_motion_summary_boxplot.png")
plt.savefig(summary_path, dpi=150, bbox_inches='tight')
plt.close()
print(f"Saved summary boxplot: {summary_path}")


