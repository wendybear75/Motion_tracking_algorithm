    def Convert(self, markerLocation, includeLRcorrelation, outputFileStem):
        start = datetime.datetime.now()
        self.m_isMLEwithLRcorrelation = includeLRcorrelation

        # Get input 2D coordinates
        m_MLEinputSamples = []
        for i in range(len(markerLocation)):
            m_MLEinputSamples.append(self.MLEsample(markerLocation.iloc[i], self._SAD, self._SID, self._isHalfFanScan,
                                                    self._pixelLengthAtIsocenter, self._xCenterPixel,
                                                    self._yCenterPixel, self._halfFanDisplacement, self._kvOffsetsX,
                                                    self._kvOffsetsY))
        self.m_MLEinputSamples = m_MLEinputSamples

        # Calculate covariance matrix parameters in two conditions
        if self.m_isMLEwithLRcorrelation: # consider LR motion
            self.MLEestimatePDF_incl_LRcorr()
        else:
            self.MLEestimatePDF_excl_LRcorr()

        determinantB = self.m_A * (self.m_B * self.m_C - self.m_F * self.m_F / 4)
        varX = (self.m_B * self.m_C - self.m_F * self.m_F / 4) / determinantB
        varY = self.m_A * self.m_C / determinantB
        varZ = self.m_A * self.m_B / determinantB
        covXY = -(self.m_C * self.m_D / 2 - self.m_E * self.m_F / 4) / determinantB
        covXZ = -(self.m_D * self.m_F / 4 - self.m_B * self.m_E / 2) / determinantB
        covYZ = -(self.m_A * self.m_F / 2 - self.m_D * self.m_E / 4) / determinantB

        # ── was hardcoded; now uses outputDirectory + outputFileStem ──────────
        covarianceFile = os.path.join(self._outputDirectory, f"covOutput_{outputFileStem}.txt")
        writeHeader = (not os.path.exists(covarianceFile))
        try:
            with open(covarianceFile, "w") as covWriter:
                if writeHeader:
                    covWriter.write("frameNo, pdfLength, varX, varY, varZ, covXY, covXZ, covYZ\n")
                if len(markerLocation) > 0:
                    covWriter.write("{0:.4f}, {1:.4f}, {2:.4f}, {3:.4f}, {4:.4f}, {5:.4f}, {6:.4f}, {7:.4f}\n".format(len(markerLocation), len(markerLocation), varX, varY, varZ, covXY, covXZ, covYZ))
                    covWriter.flush()
        except IOError:
            pass

        print("A= " + str(self.m_A) + " B= " + str(self.m_B) + " C=" + str(self.m_C) + " D=" + str(self.m_D) + " E=" + str(self.m_E) + " F=" + str(self.m_F) + " XB=" + str(self.m_Xmean) + " YB=" + str(self.m_Ymean) + " ZB=" + str(self.m_Zmean))
        elapsed = (datetime.datetime.now() - start).total_seconds() * 1000

        return varX, varY, varZ, covXY, covXZ, covYZ

    # USE THIS METHOD when LR motion is included in the MLE optimization (typical lung/abdomen)
    def MLEestimatePDF_incl_LRcorr(self):
        initialGuess_LsqrMeanPos = [0, 0, 0]
        initialGuess_MLE = [0, 0, 0, 0, 0, 0, 0, 0, 0]
        iterations = 0
        evaluations = 0
        gradientEvaluations = 0

        # Nelder-Mead simplex Least Square estimation to find the estimated mean postion (3D) of the marker
        if self.m_NoOfMLEestimations < 1: # First MLE optimization
            nm_LsqrMeanPos = minimize(self.f_LSqr, initialGuess_LsqrMeanPos, method='Nelder-Mead')
            initialGuess_MLE[0] = nm_LsqrMeanPos.x[0]
            initialGuess_MLE[1] = nm_LsqrMeanPos.x[1]
            initialGuess_MLE[2] = nm_LsqrMeanPos.x[2]
        else: # MLE optimization has been performed previously, use previous MLE optimized mean position as initial guess
            initialGuess_MLE[0] = self.m_Xmean
            initialGuess_MLE[1] = self.m_Ymean
            initialGuess_MLE[2] = self.m_Zmean

        initialGuess_MLE[3] = self.m_A
        initialGuess_MLE[4] = self.m_B
        initialGuess_MLE[5] = self.m_C
        initialGuess_MLE[6] = self.m_D
        initialGuess_MLE[7] = self.m_E
        initialGuess_MLE[8] = self.m_F
        print(initialGuess_MLE)

        # Conjugate gradient algorithm (method='CG'), self.f_MLE is objective function, self.g_MLE is derivative of objective function
        cg_PPR = minimize(self.f_MLE, initialGuess_MLE, method='CG', jac=self.g_MLE, tol=self._tolerance)

        iterations += cg_PPR.nit
        evaluations += cg_PPR.nfev
        gradientEvaluations += cg_PPR.njev

        objFctMinimum = self.f_MLE(cg_PPR.x)
        self.m_Xmean = cg_PPR.x[0]
        self.m_Ymean = cg_PPR.x[1]
        self.m_Zmean = cg_PPR.x[2]
        self.m_A = cg_PPR.x[3]
        self.m_B = cg_PPR.x[4]
        self.m_C = cg_PPR.x[5]
        self.m_D = cg_PPR.x[6]
        self.m_E = cg_PPR.x[7]
        self.m_F = cg_PPR.x[8]

        if self.m_NoOfMLEestimations < 1 or self.imageCost(len(self.m_MLEinputSamples)) > 10:
            indexOfBestInitMatrix = -1
            for i in range(len(self.A_init)):
                initialGuess_MLE[3] = self.A_init[i]
                initialGuess_MLE[4] = self.B_init[i]
                initialGuess_MLE[5] = self.C_init[i]
                initialGuess_MLE[6] = self.D_init[i]
                initialGuess_MLE[7] = self.E_init[i]
                initialGuess_MLE[8] = self.F_init[i]

                cg_PPR = minimize(self.f_MLE, initialGuess_MLE, method='CG', jac=self.g_MLE)
                iterations += cg_PPR.nit
                evaluations += cg_PPR.nfev
                gradientEvaluations += cg_PPR.njev

                if self.f_MLE(cg_PPR.x) < objFctMinimum:
                    indexOfBestInitMatrix = i
                    objFctMinimum = self.f_MLE(cg_PPR.x)
                    self.m_Xmean = cg_PPR.x[0]
                    self.m_Ymean = cg_PPR.x[1]
                    self.m_Zmean = cg_PPR.x[2]
                    self.m_A = cg_PPR.x[3]
                    self.m_B = cg_PPR.x[4]
                    self.m_C = cg_PPR.x[5]
                    self.m_D = cg_PPR.x[6]
                    self.m_E = cg_PPR.x[7]
                    self.m_F = cg_PPR.x[8]

            print(f"Extended search: Lowest min found for i: {indexOfBestInitMatrix}")

        self.m_NoOfMLEestimations += 1

