class Convert2Dto3D:
    def __init__(self, SAD, SID, pixelLengthAtIsocenter, XcenterPixel, YcenterPixel, isHalfFanScan, halfFanDisplacement,
                 kvOffsetsX, kvOffsetsY, outputDirectory):
        self._outputDirectory = outputDirectory
        self._SAD = SAD # Usually 1000 mm
        self._SID = SID
        self._halfFanDisplacement = halfFanDisplacement
        self._isHalfFanScan = isHalfFanScan # Is the scan half or full fan
        self._pixelLengthAtIsocenter = pixelLengthAtIsocenter
        self._xCenterPixel = XcenterPixel # The center pixel value
        self._yCenterPixel = YcenterPixel # The center pixel value
        self._kvOffsetsX = kvOffsetsX # An array of size 3 for the kvOffsets in X
        self._kvOffsetsY = kvOffsetsY # An array of size 3 for the kvOffsets in Y

    m_NoOfMLEestimations = 0
    log2pi = math.log(2 * math.pi)
    m_isMLEwithLRcorrelation = True
    m_MLEinputSamples = None

    A_init = [1, 5, 0.2, 1, 1, 1, 1]
    B_init = [1, 1, 1, 5, 0.2, 1, 1]
    C_init = [1, 1, 1, 1, 1, 5, 0.2]
    D_init = [0, 0, 0, 0, 0, 0, 0]
    E_init = [0, 0, 0, 0, 0, 0, 0]
    F_init = [0, 0, 0, 0, 0, 0, 0]

    A_init_prostate = [22.3, 1, 10]
    B_init_prostate = [4.0, 1, 1]
    C_init_prostate = [2.25, 1, 1]
    F_init_prostate = [-2.28, 0, 0]

    m_A, m_B, m_C, m_D, m_E, m_F, m_Xmean, m_Ymean, m_Zmean = 0, 0, 0, 0, 0, 0, 0, 0, 0
    m_maximumEvaluations = 8000
    _tolerance = 1e-7
    _convergenceFailed = False

    def TestHarness(self, filename, epsilon):
        with open(filename, 'r') as reader:
            while True:
                line = reader.readline()
                if not line:
                    break
                partsA = line.split(',')
                ndataPoints = int(partsA[0])
                markerLocations = [[0, 0, 0] for _ in range(ndataPoints)]
                outputX = [0.0] * ndataPoints
                outputY = [0.0] * ndataPoints
                outputZ = [0.0] * ndataPoints
                for i in range(ndataPoints):
                    parts = None
                    if i != 0:
                        lineB = reader.readline()
                        if not lineB:
                            break
                        parts = lineB.split(',')
                    else:
                        parts = [partsA[j + 1] for j in range(6)]
                    markerLocations[i].Gantry = float(parts[0])
                    markerLocations[i].PosX = float(parts[1])
                    markerLocations[i].PosY = float(parts[2])
                    outputX[i] = float(parts[3])
                    outputY[i] = float(parts[4])
                    outputZ[i] = float(parts[5])
                self.Convert(markerLocations, False, os.path.splitext(os.path.basename(filename))[0])
                for i in range(ndataPoints):
                    mle = self.MLEsample(markerLocations[i], self._SAD, self._SID, self._isHalfFanScan, self._pixelLengthAtIsocenter,
                                    self._xCenterPixel, self._yCenterPixel, self._halfFanDisplacement, self._kvOffsetsX, self._kvOffsetsY)
                    position = self.EstimatePosMonoscopic(markerLocations[i].Gantry, mle.Xp, mle.Yp)
        return True

