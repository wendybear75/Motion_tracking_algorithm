    def CheckStatus(self, status):
        if status == 'Converged' or status == 'EvaluationLimitExceeded':
            self._convergenceFailed = False
        else:
            self._convergenceFailed = True

    def EstimatePosMonoscopic(self, gantryAngle, xp, yp):
        viewAngleRad = gantryAngle * math.pi / 180.0
        cosViewAngle = math.cos(viewAngleRad)
        sinViewAngle = math.sin(viewAngleRad)

        Arot = self.m_A * cosViewAngle * cosViewAngle + self.m_C * sinViewAngle * sinViewAngle - self.m_E * sinViewAngle * cosViewAngle
        Brot = self.m_B
        Crot = self.m_A * sinViewAngle * sinViewAngle + self.m_C * cosViewAngle * cosViewAngle + self.m_E * sinViewAngle * cosViewAngle
        Drot = self.m_D * cosViewAngle - self.m_F * sinViewAngle
        Erot = (self.m_A - self.m_C) * math.sin(2 * viewAngleRad) + self.m_E * math.cos(2 * viewAngleRad)
        Frot = self.m_D * sinViewAngle + self.m_F * cosViewAngle

        deltaXrot = self.m_Xmean * cosViewAngle - self.m_Zmean * sinViewAngle
        deltaYrot = self.m_Ymean
        deltaZrot = self.m_Xmean * sinViewAngle + self.m_Zmean * cosViewAngle

        sigma = self._SAD / math.sqrt((Arot * xp + Drot * yp - self._SAD * Erot) * xp + (Brot * yp - self._SAD * Frot) * yp + self._SAD * self._SAD * Crot)
        my = sigma * sigma * (Arot * xp * (xp - deltaXrot) / self._SAD + Brot * yp * (yp - deltaYrot) / self._SAD + Crot * deltaZrot + Drot * (xp * (yp - deltaYrot) + (xp - deltaXrot) * yp) / self._SAD / 2 - Erot * (xp - deltaXrot + xp * deltaZrot / self._SAD) / 2 - Frot * (yp - deltaYrot + yp * deltaZrot / self._SAD) / 2)

        scaleFactor = (self._SAD - my) / self._SAD
        X = xp * scaleFactor * cosViewAngle + my * sinViewAngle
        Y = yp * scaleFactor
        Z = -xp * scaleFactor * sinViewAngle + my * cosViewAngle

        return [X, Y, Z]

    def f_LSqr(self, pos):
        Xmean = pos[0]
        Ymean = pos[1]
        Zmean = pos[2]
        sqrSum = 0
        for i in range(len(self.m_MLEinputSamples)):
            scaleFactor = self._SAD / (self._SAD - self.m_MLEinputSamples[i].SinAngle * Xmean - self.m_MLEinputSamples[i].CosAngle * Zmean)
            XpForGuess = (self.m_MLEinputSamples[i].CosAngle * Xmean - self.m_MLEinputSamples[i].SinAngle * Zmean) * scaleFactor
            YpForGuess = Ymean * scaleFactor
            sqrSum += (XpForGuess - self.m_MLEinputSamples[i].Xp) ** 2 + (YpForGuess - self.m_MLEinputSamples[i].Yp) ** 2
        return sqrSum

    def f_MLE(self, covPos):
        Xmean, Ymean, Zmean, A, B, C = covPos[0], covPos[1], covPos[2], covPos[3], covPos[4], covPos[5]

        if self.m_isMLEwithLRcorrelation:
            D, E, F = covPos[6], covPos[7], covPos[8]
        else:
            D, E, F = 0, 0, covPos[6]

        determinantB = A * (B * C - F * F / 4) - D / 2 * (D * C / 2 - E * F / 4) + E / 2 * (D * F / 4 - B * E / 2)

        if (determinantB <= 0) or (A * B <= D ** 2 / 4) or (A <= 0):
            return 1000000000000000
        else:
            minusLogProbabilityProduct = len(self.m_MLEinputSamples) * math.log(2 * math.pi)
            for i in range(len(self.m_MLEinputSamples)):
                Fx = self.m_MLEinputSamples[i].Fx
                Fy = self.m_MLEinputSamples[i].Fy
                Fz = self.m_MLEinputSamples[i].Fz
                Mx = -(self.m_MLEinputSamples[i].Xp * self.m_MLEinputSamples[i].CosAngle - Xmean)
                My = -(self.m_MLEinputSamples[i].Yp - Ymean)
                Mz = -(-self.m_MLEinputSamples[i].Xp * self.m_MLEinputSamples[i].SinAngle - Zmean)
                Xp = self.m_MLEinputSamples[i].Xp
                Yp = self.m_MLEinputSamples[i].Yp
                sqrtDeterminantB = math.sqrt(determinantB)

                if self.m_isMLEwithLRcorrelation:
                    sigma = self._SAD / math.sqrt((A * Fx + D * Fy + E * Fz) * Fx + (B * Fy + F * Fz) * Fy + C * Fz * Fz)
                    myOVERsigma = sigma * (A * Fx * Mx + B * Fy * My + C * Fz * Mz + D / 2 * (Fx * My + Fy * Mx) + E / 2 * (Fx * Mz + Fz * Mx) + F / 2 * (Fz * My + Fy * Mz)) / self._SAD
                    minusLogProbabilityProduct -= (math.log(sqrtDeterminantB * sigma) - 0.5 * ((A * Mx + D * My + E * Mz) * Mx + (B * My + F * Mz) * My + C * Mz * Mz - myOVERsigma * myOVERsigma))
                else:
                    sigma = self._SAD / math.sqrt(A * Fx * Fx + (B * Fy + F * Fz) * Fy + C * Fz * Fz)
                    myOVERsigma = sigma * (A * Fx * Mx + B * Fy * My + C * Fz * Mz + F / 2 * (Fz * My + Fy * Mz)) / self._SAD
                    minusLogProbabilityProduct -= (math.log(sqrtDeterminantB * sigma) - 0.5 * (A * Mx * Mx + (B * My + F * Mz) * My + C * Mz * Mz - myOVERsigma * myOVERsigma))

            return minusLogProbabilityProduct

    def imageCost(self, imageNumber):
        try:
            determinantB = self.m_A * (self.m_B * self.m_C - self.m_F * self.m_F / 4) - self.m_D / 2 * (self.m_D * self.m_C / 2 - self.m_E * self.m_F / 4) + self.m_E / 2 * (self.m_D * self.m_F / 4 - self.m_B * self.m_E / 2)

            if (determinantB <= 0) or (self.m_A * self.m_B <= self.m_D * self.m_D / 4) or (self.m_A <= 0):
                return 1000000000000000
            else:
                currentMLEsample = self.m_MLEinputSamples[imageNumber - 1]
                Fx = currentMLEsample.Fx
                Fy = currentMLEsample.Fy
                Fz = currentMLEsample.Fz
                Mx = -(currentMLEsample.Xp * currentMLEsample.CosAngle - self.m_Xmean)
                My = -(currentMLEsample.Yp - self.m_Ymean)
                Mz = -(-currentMLEsample.Xp * currentMLEsample.SinAngle - self.m_Zmean)
                Xp = currentMLEsample.Xp
                Yp = currentMLEsample.Yp
                sqrtDeterminantB = math.sqrt(determinantB)

                if self.m_isMLEwithLRcorrelation:
                    sigma = self._SAD / math.sqrt((self.m_A * Fx + self.m_D * Fy + self.m_E * Fz) * Fx + (self.m_B * Fy + self.m_F * Fz) * Fy + self.m_C * Fz * Fz)
                    myOVERsigma = sigma * (self.m_A * Fx * Mx + self.m_B * Fy * My + self.m_C * Fz * Mz + self.m_D / 2 * (Fx * My + Fy * Mx) + self.m_E / 2 * (Fx * Mz + Fz * Mx) + self.m_F / 2 * (Fz * My + Fy * Mz)) / self._SAD
                    minusLogProbability = -(math.log(sqrtDeterminantB * sigma) - math.log(2 * math.pi) - 0.5 * ((self.m_A * Mx + self.m_D * My + self.m_E * Mz) * Mx + (self.m_B * My + self.m_F * Mz) * My + self.m_C * Mz * Mz - myOVERsigma * myOVERsigma))
                else:
                    sigma = self._SAD / math.sqrt(self.m_A * Fx * Fx + (self.m_B * Fy + self.m_F * Fz) * Fy + self.m_C * Fz * Fz)
                    myOVERsigma = sigma * (self.m_A * Fx * Mx + self.m_B * Fy * My + self.m_C * Fz * Mz + self.m_F / 2 * (Fz * My + Fy * Mz)) / self._SAD
                    minusLogProbability = -(math.log(sqrtDeterminantB * sigma) - math.log(2 * math.pi) - 0.5 * (self.m_A * Mx * Mx + (self.m_B * My + self.m_F * Mz) * My + self.m_C * Mz * Mz - myOVERsigma * myOVERsigma))
                return minusLogProbability
        except:
            return 1000000000000000

    def g_MLE(self, covPos):
        if self.m_isMLEwithLRcorrelation:
            f = [0] * 9
        else:
            f = [0] * 7

        Xmean, Ymean, Zmean, A, B, C = covPos[0], covPos[1], covPos[2], covPos[3], covPos[4], covPos[5]

        if self.m_isMLEwithLRcorrelation:
            D, E, F = covPos[6], covPos[7], covPos[8]
        else:
            D, E, F = 0, 0, covPos[6]

        determinantB = A * (B * C - F * F / 4) - D / 2 * (D * C / 2 - E * F / 4) + E / 2 * (D * F / 4 - B * E / 2)

        if (determinantB > 0) and (A * B > D ** 2 / 4) and (A > 0):
            derivXmean = 0
            derivYmean = 0
            derivZmean = 0
            derivA = 0
            derivB = 0
            derivC = 0
            derivD = 0
            derivE = 0
            derivF = 0
            for i in range(len(self.m_MLEinputSamples)):
                Fx = self.m_MLEinputSamples[i].Fx
                Fy = self.m_MLEinputSamples[i].Fy
                Fz = self.m_MLEinputSamples[i].Fz
                Mx = -(self.m_MLEinputSamples[i].Xp * self.m_MLEinputSamples[i].CosAngle - Xmean)
                My = -(self.m_MLEinputSamples[i].Yp - Ymean)
                Mz = -(-self.m_MLEinputSamples[i].Xp * self.m_MLEinputSamples[i].SinAngle - Zmean)

                if self.m_isMLEwithLRcorrelation:
                    sigmaOverSADsquared = 1 / ((A * Fx + D * Fy + E * Fz) * Fx + (B * Fy + F * Fz) * Fy + C * Fz * Fz)
                    myOverSAD = sigmaOverSADsquared * (A * Fx * Mx + B * Fy * My + C * Fz * Mz + D / 2 * (Fx * My + Fy * Mx) + E / 2 * (Fx * Mz + Fz * Mx) + F / 2 * (Fz * My + Fy * Mz))
                    derivXmean += A * Mx + 0.5 * (D * My + E * Mz - myOverSAD * (2 * A * Fx + D * Fy + E * Fz))
                    derivYmean += B * My + 0.5 * (D * Mx + F * Mz - myOverSAD * (2 * B * Fy + D * Fx + F * Fz))
                    derivZmean += C * Mz + 0.5 * (E * Mx + F * My - myOverSAD * (2 * C * Fz + E * Fx + F * Fy))
                    derivA += 0.5 * ((F * F / 4 - B * C) / determinantB + Mx * Mx + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fx * Fx) - myOverSAD * Fx * Mx
                    derivB += 0.5 * ((E * E / 4 - A * C) / determinantB + My * My + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fy * Fy) - myOverSAD * Fy * My
                    derivC += 0.5 * ((D * D / 4 - A * B) / determinantB + Mz * Mz + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fz * Fz) - myOverSAD * Fz * Mz
                    derivD += 0.5 * ((D * C / 2 - E * F / 4) / determinantB + Mx * My + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fx * Fy - myOverSAD * (Fx * My + Fy * Mx))
                    derivE += 0.5 * ((B * E / 2 - D * F / 4) / determinantB + Mx * Mz + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fx * Fz - myOverSAD * (Fx * Mz + Fz * Mx))
                    derivF += 0.5 * ((A * F / 2 - D * E / 4) / determinantB + My * Mz + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fy * Fz - myOverSAD * (Fy * Mz + Fz * My))
                else:
                    sigmaOverSADsquared = 1 / (A * Fx * Fx + (B * Fy + F * Fz) * Fy + C * Fz * Fz)
                    myOverSAD = sigmaOverSADsquared * (A * Fx * Mx + B * Fy * My + C * Fz * Mz + F / 2 * (Fz * My + Fy * Mz))
                    derivXmean += A * Mx + 0.5 * (-myOverSAD * (2 * A * Fx))
                    derivYmean += B * My + 0.5 * (F * Mz - myOverSAD * (2 * B * Fy + F * Fz))
                    derivZmean += C * Mz + 0.5 * (F * My - myOverSAD * (2 * C * Fz + F * Fy))
                    derivA += 0.5 * ((F * F / 4 - B * C) / determinantB + Mx * Mx + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fx * Fx) - myOverSAD * Fx * Mx
                    derivB += 0.5 * ((-A * C) / determinantB + My * My + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fy * Fy) - myOverSAD * Fy * My
                    derivC += 0.5 * ((-A * B) / determinantB + Mz * Mz + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fz * Fz) - myOverSAD * Fz * Mz
                    derivF += 0.5 * ((A * F / 2) / determinantB + My * Mz + (sigmaOverSADsquared + myOverSAD * myOverSAD) * Fy * Fz - myOverSAD * (Fy * Mz + Fz * My))

            f[0] = derivXmean
            f[1] = derivYmean
            f[2] = derivZmean
            f[3] = derivA
            f[4] = derivB
            f[5] = derivC
            if self.m_isMLEwithLRcorrelation:
                f[6] = derivD
                f[7] = derivE
                f[8] = derivF
            else:
                f[6] = derivF

        return f

    class MLEsample:
        @staticmethod
        def XKVOffset(kVOffsetX, viewAngle, isHalfFanScan, halfFanDisplacement, pixelLengthAtIsocenter, SID, SAD):
            return kVOffsetX[0] + kVOffsetX[1] * math.sin((180 - (viewAngle + 90) + kVOffsetX[2]) * math.pi / 180) - (halfFanDisplacement / (pixelLengthAtIsocenter * SID / SAD) if isHalfFanScan else 0)

        @staticmethod
        def YKVOffset(kVOffsetX, viewAngle):
            return kVOffsetX[0] + kVOffsetX[1] * math.sin((180 - (viewAngle + 90) + kVOffsetX[2]) * math.pi / 180)

        def __init__(self, marker, SAD, SID, isHalfFanScan, pixelLengthAtIsocenter, xCenterPixel, yCenterPixel, halfFanDisplacement, kVOffSetsX, kvOffSetsY):
            markerPixelX = marker.PosX
            markerPixelY = marker.PosY
            viewAngle = marker.Gantry

            kVoffsetX = marker.ElektaKVOffsetX if marker.ElektaKVOffsetX != 0 else self.XKVOffset(kVOffSetsX, viewAngle,
                                                                                                  isHalfFanScan,
                                                                                                  halfFanDisplacement,
                                                                                                  pixelLengthAtIsocenter,
                                                                                                  SID, SAD)
            kVoffsetY = marker.ElektaKVOffsetY if marker.ElektaKVOffsetY != 0 else self.YKVOffset(kvOffSetsY, viewAngle)

            self._Xp = pixelLengthAtIsocenter * (markerPixelX - xCenterPixel - kVoffsetX/0.8)
            self._Yp = -pixelLengthAtIsocenter * (markerPixelY - yCenterPixel - kVoffsetY/0.8)
            self._ViewAngle = viewAngle
            self._SinAngle = math.sin(viewAngle * math.pi / 180.0)
            self._CosAngle = math.cos(viewAngle * math.pi / 180.0)

            self.Fx = SAD * self.SinAngle - self.Xp * self.CosAngle
            self.Fy = -self.Yp
            self.Fz = SAD * self.CosAngle + self.Xp * self.SinAngle

        @property
        def Xp(self):
            return self._Xp

        @Xp.setter
        def Xp(self, value):
            self._Xp = value

        @property
        def Yp(self):
            return self._Yp

        @Yp.setter
        def Yp(self, value):
            self._Yp = value

        @property
        def ViewAngle(self):
            return self._ViewAngle

        @ViewAngle.setter
        def ViewAngle(self, value):
            self._ViewAngle = value

        @property
        def SinAngle(self):
            return self._SinAngle

        @SinAngle.setter
        def SinAngle(self, value):
            self._SinAngle = value

        @property
        def CosAngle(self):
            return self._CosAngle

        @CosAngle.setter
        def CosAngle(self, value):
            self._CosAngle = value

        def __str__(self):
            return f"Xp: {self.Xp}, Yp: {self.Yp}, ViewAngle: {self.ViewAngle}, SinAngle: {self.SinAngle}, CosAngle: {self.CosAngle}, Fx: {self.Fx}, Fy: {self.Fy}, Fz: {self.Fz}"


